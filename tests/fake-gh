#!/usr/bin/env bash
# Fake gh for tests. Serves JSON from $FIX, keeps tiny state in $PR_AUTOPILOT_STATE/fake/, and records
# every write as one line in $PR_AUTOPILOT_STATE/writes.log.
S=$PR_AUTOPILOT_STATE/fake; mkdir -p "$S"
W=$PR_AUTOPILOT_STATE/writes.log
# FAKE_GH_FLAKY=N: the first N calls fail with a transient network error (FAKE_GH_FLAKY_MSG).
if [ -n "${FAKE_GH_FLAKY:-}" ]; then
  c=$(cat "$S/flaky" 2>/dev/null || echo 0)
  if [ "$c" -lt "$FAKE_GH_FLAKY" ]; then echo $((c + 1)) >"$S/flaky"; echo "${FAKE_GH_FLAKY_MSG:-Get \"https://api.github.com/user\": net/http: TLS handshake timeout}" >&2; exit 1; fi
fi
args=("$@"); ep="" expr="" method=GET fields=() reviewers=() event="" commit_id=""
if [ "${1:-}" = pr ] && [ "${2:-}" = diff ]; then
  [ -n "${FAKE_DIFF_TOO_LARGE:-}" ] && { echo "could not find pull request diff: HTTP 406: Sorry, the diff exceeded the maximum number of lines (20000)" >&2; exit 1; }
  cat "$FIX/diff.patch"; exit 0; fi
i=0
while [ $i -lt ${#args[@]} ]; do
  a=${args[$i]}
  case $a in
    --jq) i=$((i + 1)); expr=${args[$i]} ;;
    -X) i=$((i + 1)); method=${args[$i]} ;;
    -f | -F)
      i=$((i + 1)); f=${args[$i]}; [ "$method" = GET ] && method=POST; fields+=("$f")
      case $f in
        reviewers\[\]=*) reviewers+=("${f#*=}") ;;
        event=*) event=${f#*=} ;;
        commit_id=*) commit_id=${f#*=} ;;
        body=*) bodyv=${f#*=} ;;
        title=*) titlev=${f#*=} ;;
      esac ;;
    --paginate | api) ;;
    user | notifications* | repos/* | search/*) ep=$a ;;
  esac
  i=$((i + 1))
done
if [ -n "${FAKE_GH_FAIL:-}" ] && [ "$method $ep" = "$FAKE_GH_FAIL" ]; then echo "fake gh: forced failure" >&2; exit 1; fi
# FAKE_WRITE_502=1: every write is applied and then answered with a 502, as when a proxy drops the reply.
if [ -n "${FAKE_WRITE_502:-}" ] && [ "$method" != GET ] && [ -z "${FAKE_IN_502:-}" ]; then
  FAKE_IN_502=1 "$0" "$@" >/dev/null 2>&1; echo "gh: Bad Gateway (HTTP 502)" >&2; exit 1
fi
store() { # store <html_url>: remember a created comment/issue for later GETs
  jq -n --arg u "$1" --arg b "${bodyv:-}" --arg t "${titlev:-}" --arg rt "${2:-}" '{id: 5555, user: {login: "me"}, body: $b, html_url: $u, created_at: (now | todate)} + (if $rt != "" then {in_reply_to_id: ($rt | tonumber)} else {} end) + (if $t != "" then {title: $t} else {} end)' >"$S/new1"
  jq -s 'add' <(cat "$S/posted-comments.json" 2>/dev/null || echo '[]') <(jq -s . "$S/new1") >"$S/p1.tmp" && mv "$S/p1.tmp" "$S/posted-comments.json"
}
merged() { jq -s 'add' <(cat "$1" 2>/dev/null || echo '[]') <(cat "$S/posted-comments.json" 2>/dev/null || echo '[]'); }
out() { if [ -n "$expr" ]; then jq -r "$expr"; else cat; fi; }
num() { sed -E 's#^repos/[^/]+/[^/]+/(pulls|issues)/([0-9]+).*#\2#' <<<"$1"; }

case "$method $ep" in
  "GET user") echo '{"login":"me"}' | out ;;
  "GET notifications"*) if [ -n "${FAKE_NOTIF_EMPTY:-}" ]; then echo '[]'; else cat "$FIX"/notifications*.json; fi ;;
  "GET search/issues"*review-requested*) cat "$FIX/search-review.json" ;;
  "GET search/issues"*author*) cat "$FIX/search-author.json" ;;
  "PATCH notifications/threads/"*) echo "PATCH $ep" >>"$W" ;;
  "GET repos/"*/pulls/*/reviews/*)
    jq --argjson id "${ep##*/}" '.[] | select(.id == $id)' "$S/posted-reviews.json" | out ;;
  "GET repos/"*/pulls/*/reviews)
    n=$(num "$ep")
    jq -s 'add' <(cat "$FIX/reviews-$n.json" 2>/dev/null || echo '[]') <(cat "$S/posted-reviews.json" 2>/dev/null || echo '[]') ;;
  "POST repos/"*/pulls/*/reviews)
    state=APPROVED; [ "$event" = REQUEST_CHANGES ] && state=CHANGES_REQUESTED
    echo "POST $ep event=$event commit_id=$commit_id" >>"$W"
    jq -n --arg c "$commit_id" --arg s "$state" '{id: 777, user: {login: "me"}, commit_id: $c, state: $s, submitted_at: (now | todate)}' >"$S/new"
    jq -s 'add' <(cat "$S/posted-reviews.json" 2>/dev/null || echo '[]') <(jq -s . "$S/new") >"$S/p.tmp" && mv "$S/p.tmp" "$S/posted-reviews.json"
    cat "$S/new" ;;
  "GET repos/"*/pulls/*/files) cat "$FIX/files-$(num "$ep").json" ;;
  "GET repos/"*/pulls/*/comments) merged "$FIX/comments-$(num "$ep").json" ;;
  "POST repos/"*/pulls/*/comments/*/replies) echo "POST $ep ${fields[*]}" >>"$W"; store "https://github.com/$ep#c888" "$(sed -E 's#.*/comments/([0-9]+)/replies#\1#' <<<"$ep")"; echo '{"id": 888}' ;;
  "GET repos/"*/issues\?*) jq '[.[] | select(.title != null)]' <(merged /dev/null) ;;
  "GET repos/"*/issues/*/comments) merged "$FIX/issue-$(num "$ep").json" ;;
  "POST repos/"*/issues/*/comments)
    echo "POST $ep ${fields[*]}" >>"$W"; store "https://github.com/$ep#c889"; jq -n --arg u "https://github.com/$ep" '{id: 889, html_url: ($u + "#c889")}' | out ;;
  "POST repos/"*/issues)
    echo "POST $ep ${fields[*]}" >>"$W"; store "https://github.com/acme/app/issues/99"; echo '{"id": 890, "number": 99, "html_url": "https://github.com/acme/app/issues/99"}' | out ;;
  "PATCH repos/"*/pulls/*)
    echo "PATCH $ep ${fields[*]}" >>"$W"; if [ -n "${FAKE_BODY_CRLF:-}" ]; then printf '%s \r\n' "${fields[0]#body=}"; else printf '%s' "${fields[0]#body=}"; fi >"$S/body-$(num "$ep")"; echo '{}' ;;
  "POST repos/"*/pulls/*/requested_reviewers)
    echo "POST $ep ${reviewers[*]}" >>"$W"
    printf '%s\n' "${reviewers[@]}" | jq -R '{login: .}' | jq -s . >"$S/requested.json"; echo '{}' ;;
  "GET repos/"*/commits/*/check-runs*)
    if [ -n "${FAKE_CHECKS:-}" ]; then cat "$FAKE_CHECKS"; else echo '{"check_runs": []}'; fi | out ;;
  "GET repos/"*/actions/jobs/*/logs) printf 'step 1\nFAIL src/a.test.ts > expects the old label\nExpected: "A" Received: "B"\n' ;;
  "POST repos/"*/actions/runs/*/rerun-failed-jobs) echo "POST $ep" >>"$W"; echo '{}' ;;
  "GET repos/"*/pulls/*)
    n=$(num "$ep")
    sha=""; [ -n "${FAKE_HEAD_REPO:-}" ] && sha=$(git -C "$FAKE_HEAD_REPO" rev-parse refs/heads/feature-11)
    jq --arg sha "$sha" --slurpfile rr <(cat "$S/requested.json" 2>/dev/null || echo '[]') --rawfile b <(cat "$S/body-$n" 2>/dev/null) \
      '(if $sha != "" then .head.sha = $sha else . end) | .requested_reviewers = $rr[0] | if $b != "" then .body = $b else . end' "$FIX/pr-$n.json" | out ;;
  *) echo "fake gh: unexpected call: $*" >&2; exit 1 ;;
esac
