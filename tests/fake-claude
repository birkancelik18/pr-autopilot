#!/usr/bin/env bash
# Fake claude for job tests. FAKE_CLAUDE picks the behaviour. Records what the job gave it.
S=$PR_AUTOPILOT_STATE
printf '%s\n' "$PWD" "$@" >"$S/claude.args"
find . -not -path './.git' -not -path './.git/*' -type f | sort >"$S/claude.cwdfiles"
jd=$(printf '%s\n' "$@" | grep -o 'job_dir=[^ ]*' | head -1 | cut -d= -f2)
echo "$jd" >"$S/claude.jobdir"
if grep -q 'SHORTEN the review draft' "$S/claude.args" && [ -z "${FAKE_SHORTEN_FAIL:-}" ]; then
  printf 'VERDICT: APPROVE\n\nShort enough now.\n' >"$jd/draft.md"
  echo '{"type":"result","subtype":"success","result":"shortened","is_error":false,"permission_denials":[],"num_turns":2,"duration_ms":10,"total_cost_usd":0.05}'
  exit 0
fi
case "${FAKE_CLAUDE:-review}" in
  review) printf 'VERDICT: APPROVE\n\nNo blockers found.\n' >"$jd/draft.md" ;;
  review-rc) printf 'VERDICT: REQUEST_CHANGES\n\nsrc/a.txt:2 drops the null check, so empty input crashes.\n' >"$jd/draft.md" ;;
  review-long) { printf 'VERDICT: APPROVE\n\n'; for i in $(seq 1 200); do printf 'word '; done; } >"$jd/draft.md" ;;
  review-badverdict) printf 'LGTM\n\nfine\n' >"$jd/draft.md" ;;
  fix)
    echo fixed >>src/a.txt; echo junk >junk.txt
    cat >"$jd/result.json" <<'J'
{"summary": "the missing null check", "commit_message": "Add null check @everyone", "files": ["src/a.txt"],
 "replies": [{"in_reply_to": 5001, "body": "Fixed in {{sha}}, thanks @bob."}], "re_request": ["bob", "stranger"]}
J
    ;;
  conflict | conflict-markers | conflict-unresolved | conflict-stray)
    while IFS= read -r f; do
      case $FAKE_CLAUDE in conflict-markers) ;; *) printf 'main side\npr side\n' >"$f" ;; esac
    done <"$jd/conflicts.txt"
    [ "$FAKE_CLAUDE" = conflict-stray ] && echo tampered >>src/other.txt
    if [ "$FAKE_CLAUDE" = conflict-unresolved ]; then
      echo '{"summary":"x","unresolved":[{"file":"src/a.txt","why":"both sides change the rule differently"}]}' >"$jd/result.json"
    else echo '{"summary":"kept both lines","unresolved":[]}' >"$jd/result.json"; fi ;;
  cifix-fix)
    echo fixed >>src/a.txt
    echo '{"action":"fix","summary":"the test expected the old label","commit_message":"Fix the label test","files":["src/a.txt"]}' >"$jd/result.json" ;;
  cifix-rerun) echo '{"action":"rerun","summary":"the runner lost its network","files":[]}' >"$jd/result.json" ;;
  cifix-none) echo '{"action":"none","summary":"a deploy secret is missing in CI","files":[]}' >"$jd/result.json" ;;
  fix-decline)
    echo fixed >>src/a.txt
    echo '{"summary":"x","files":["src/a.txt"],"replies":[{"in_reply_to":5001,"body":"Fixed one, declined the other: out of scope."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-nothing) # PR 1623: the model had nothing to do and wrote empty lists
    echo '{"summary":"nothing","commit_message":"","files":[],"replies":[],"re_request":[],"pr_body":"","deferrals":[],"promises":[],"escalate":""}' >"$jd/result.json" ;;
  fix-blank-deferral) # a blank title must be refused before any write
    echo '{"summary":"x","files":[],"deferrals":[{"issue_title":"  ","body":"x"}],"replies":[{"in_reply_to":5001,"body":"Tracked in {{deferral:0}}."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-blank-reply)
    echo '{"summary":"x","files":[],"replies":[{"in_reply_to":5001,"body":" "}],"re_request":[]}' >"$jd/result.json" ;;
  fix-badreply)
    echo '{"summary":"x","replies":[{"in_reply_to":424242,"body":"hi"}],"re_request":[]}' >"$jd/result.json" ;;
  fix-many)
    echo fixed >>src/a.txt
    echo '{"summary":"x","files":["src/a.txt"],"replies":[{"in_reply_to":5001,"body":"a"},{"in_reply_to":5001,"body":"b"}],"re_request":[]}' >"$jd/result.json" ;;
  fix-promise-unmet) # PR 1554: promised a description fix it never made
    echo '{"summary":"x","files":[],"replies":[{"in_reply_to":5001,"body":"Good catch, I will correct the PR description."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-defer-unrecorded) # PR 1554: deferred to another PR with nothing recorded there
    echo '{"summary":"x","files":[],"replies":[{"in_reply_to":5001,"body":"This belongs in P3 (#12), not here."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-defer-foreign)
    echo '{"summary":"x","files":[],"deferrals":[{"pr":13,"body":"Add the constraint."}],"replies":[{"in_reply_to":5001,"body":"Belongs in #13: {{deferral:0}}."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-defer-issue)
    echo '{"summary":"x","files":[],"deferrals":[{"issue_title":"Enforce uniqueness","body":"From review."}],"replies":[{"in_reply_to":5001,"body":"Out of this PR, tracked in {{deferral:0}}."}],"re_request":[],"escalate":"Docs only; a 10-line constraint would close it."}' >"$jd/result.json" ;;
  fix-curly) # a typographic apostrophe must not hide a promise
    echo '{"summary":"x","files":[],"replies":[{"in_reply_to":5001,"body":"Good catch, I’ll correct the PR description."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-two-deferrals)
    echo '{"summary":"x","files":[],"deferrals":[{"pr":12,"body":"First."},{"issue_title":"Second","body":"Second."}],"replies":[{"in_reply_to":5001,"body":"Recorded in {{deferral:0}} and {{deferral:1}}."}],"re_request":[],"escalate":"Two deferred points."}' >"$jd/result.json" ;;
  fix-many-deferrals)
    echo '{"summary":"x","files":[],"deferrals":[{"issue_title":"a","body":"a"},{"issue_title":"b","body":"b"},{"issue_title":"c","body":"c"},{"issue_title":"d","body":"d"}],"replies":[{"in_reply_to":5001,"body":"{{deferral:0}} {{deferral:1}} {{deferral:2}} {{deferral:3}}"}],"re_request":[]}' >"$jd/result.json" ;;
  fix-docsonly) # docs-only answer to a changes request, no escalation written by the model
    mkdir -p docs; echo limit >docs/limits.md
    echo '{"summary":"the documented limit","files":["docs/limits.md"],"replies":[{"in_reply_to":5001,"body":"Documented the limit in {{sha}}."}],"re_request":[]}' >"$jd/result.json" ;;
  fix-1554-done) # the same review answered properly: description fixed, deferral recorded, owner told
    [ -n "${FAKE_BODY_RACE:-}" ] && { mkdir -p "$S/fake"; printf 'edited by the owner meanwhile' >"$S/fake/body-11"; }
    mkdir -p docs; echo limit >docs/limits.md
    cat >"$jd/result.json" <<'J'
{"summary": "the documented limit", "files": ["docs/limits.md"], "pr_body": "Adds the limit. It does not enforce uniqueness yet.",
 "deferrals": [{"pr": 12, "body": "Carry over from #11: enforce uniqueness with a constraint."}],
 "replies": [{"in_reply_to": 5001, "body": "Documented the limit in {{sha}} and corrected the PR description. The constraint belongs in P3 (#12), recorded there: {{deferral:0}}."}],
 "promises": [{"reply": 0, "text": "corrected the PR description", "done_by": "pr_body"}],
 "escalate": "My call: docs now, constraint in #12. Cheap code option: a unique constraint plus migration, about 10 lines.",
 "re_request": ["bob"]}
J
    ;;
  hang) sleep 300 & echo $! >"$S/hang.pid"; wait ;;
  none) ;;
  limit) echo '{"type":"result","subtype":"success","result":"You'"'"'ve hit your session limit","is_error":true,"total_cost_usd":0}'; exit 1 ;;
  crash) echo boom >&2; exit 1 ;;
esac
if [ "${FAKE_CLAUDE:-review}" != fix ] && [ "${FAKE_CLAUDE:-review}" != fix-many ] && [ "${FAKE_CLAUDE:-review}" != fix-decline ] && [ "${FAKE_CLAUDE:-review}" != crash ]; then
  agents=$(for i in $(seq 1 "${FAKE_AGENTS:-3}"); do printf '{"type":"tool_use","id":"toolu_%s","name":"Agent","input":{}},' "$i"; done)
  echo "{\"type\":\"assistant\",\"parent_tool_use_id\":null,\"message\":{\"id\":\"msg_1\",\"content\":[${agents%,}]}}"
fi
echo '{"type":"result","subtype":"success","result":"done","is_error":false,"permission_denials":[],"num_turns":5,"duration_ms":1234,"total_cost_usd":0.5}'
